# Copy this file to `.env` and fill in your key.
# ADK uses Google Gemini models by default.

# Option A: Google AI Studio key (simplest — get one at https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your_api_key_here

# Option B: Vertex AI (uncomment and configure instead of the key above)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
